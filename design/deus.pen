                            {
                              "type": "text",
                              "id": "gRRZJ",
                              "name": "PROPOSAL",
                              "fill": "$text-disabled",
                              "content": "PROPOSAL · Cloud account controls superseded by implemented board 54d",
                              "fontFamily": "$font-sans",
                              "fontSize": "$text-2xs",
                              "fontWeight": "600",
                              "letterSpacing": 0.54
                            },
                            {
                              "type": "text",
                              "id": "Onxs0",
                              "name": "rationale",
                              "fill": "$text-muted",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "One row per provider instead of one always-open card, and every provider carries TWO lanes: Local (the CLI on this machine + its API key) and Cloud (the subscription credential cloud sandboxes run on). Status sits on the far right, one chip per lane, and a lane that is broken says WHICH — a bare dot cannot tell 'not installed' from 'signed out'. A row opens when it needs you and stays shut when it is healthy. The Cloud lane is not moved out of Settings → Cloud: it is ONE component mounted in both places, the way GithubAppCard already renders in both GitHub and Cloud. Adding a third provider becomes an array entry, not 90 lines of JSX. Every state this row can be in — 14 of them — plus the connect flow is on board 54b.",
                              "lineHeight": 1.5,
                              "fontFamily": "$font-sans",
                              "fontSize": 10,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }

{
  "name": "device-use",
  "version": "0.1.0",
  "description": "Deus's iOS Simulator engine: simctl, the simbridge helper (screen stream, input, accessibility) and the siminspector dylib.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    },
    "./engine": {
      "import": "./dist/engine.js",
      "types": "./dist/engine.d.ts"
    }
  },
  "main": "./dist/engine.js",
  "types": "./dist/engine.d.ts",
  "scripts": {
    "build:native": "bun run scripts/build-native.ts",
    "build:ts": "bun run scripts/build-ts.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.8.0"
  }
}

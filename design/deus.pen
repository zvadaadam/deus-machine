              "letterSpacing": -0.8
            },
            {
              "type": "text",
              "id": "NJ6pn",
              "name": "sub",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 1180,
              "content": "Providers, GitHub, Browser and Cloud all answer the same question — what may the agent use, and with whose credentials. So they stop being four screens and become five rows you can read in two seconds. Identity moves into the sidebar header. Environments moves onto the repository. Everything left is the same cell.",
              "lineHeight": 1.5,
              "fontFamily": "$font-sans",
              "fontSize": "$text-lg",
              "fontWeight": "normal"
            }
          ]
        },

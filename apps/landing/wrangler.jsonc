{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "deus-landing",
	"account_id": "e247e098b7e2f5bee57ae8cf303b97df",
	"compatibility_date": "2026-04-01",
	"compatibility_flags": ["nodejs_compat"],
	// Custom entry: the root-domain edge router (landing at `/` for new
	// visitors, the deus web app everywhere else). See src/server.ts.
	"main": "src/server.ts",
	"vars": {
		"APP_ORIGIN": "https://deus.pages.dev"
	},
	"routes": [
		{ "pattern": "deusmachine.ai", "custom_domain": true }
	]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "apps/backend/src/server.ts",
        "apps/agent-server/index.ts",
        "apps/desktop/main/index.ts",
        "apps/desktop/preload/index.ts",
        "apps/desktop/preload/browser-preload.ts",
        "shared/types/index.ts",
        "shared/events.ts",
        "apps/runtime/index.ts",
        "shared/protocol.ts",
        "shared/schema.ts",
        "shared/enums.ts",
        "shared/lib/*.ts",
        "apps/cli/src/cli.ts",
        "scripts/generate-integration-icons.ts",
        "apps/**/test/**/*.ts",
        "test/**/*.ts"
      ],
      "project": ["apps/**/*.{ts,tsx}", "shared/**/*.ts", "test/**/*.ts", "!**/*.d.ts"],
      "paths": {
        "@/*": ["apps/web/src/*"],
        "@/app/*": ["apps/web/src/app/*"],
        "@/features/*": ["apps/web/src/features/*"],
        "@/platform/*": ["apps/web/src/platform/*"],
        "@/shared/*": ["apps/web/src/shared/*"],
        "@/components/*": ["apps/web/src/components/*"],
        "@/lib/*": ["apps/web/src/shared/lib/*"],
        "@/hooks/*": ["apps/web/src/shared/hooks/*"],
        "@/ui/*": ["apps/web/src/components/ui/*"],
        "@shared/*": ["shared/*"]
      },
      "vitest": {
        "config": [
          "apps/backend/vitest.config.ts",
          "apps/agent-server/vitest.config.ts",
          "test/vitest.config.ts"
        ],
        "entry": ["apps/**/test/**/*.{test,spec}.ts", "test/**/*.{test,spec}.ts"]
      },
      "vite": {
        "config": ["apps/web/vite.config.ts"]
      },
      "eslint": {
        "config": ["eslint.config.mjs"]
      }
    },
    "packages/device-use": {
      "entry": ["src/engine/index.ts", "scripts/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/screen-studio": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/runtime-client": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignore": ["apps/cloud-relay/**", "apps/landing/**"],
  "ignoreDependencies": [
    "yallist",
    "tailwindcss",
    "esbuild",
    "@electron/rebuild",
    "@napi-rs/canvas",
    "@iconify-json/logos"
  ],
  "ignoreBinaries": ["wrangler", "swift", "scripts/e2e-server.ts", "typescript/bin/tsc"],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": ["apps/web/src/components/ui/button-group.tsx"],
  "ignoreUnresolved": ["./test/setup.ts"],
  "ignoreIssues": {
    "apps/web/src/components/ui/**": ["exports", "types"],
    "apps/web/src/platform/native/**": ["exports"]
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "enumMembers": "off"
  }
}

{
  "name": "@deus/screen-studio",
  "version": "0.2.0",
  "description": "Record what an agent does — browser tabs, iOS Simulators, displays — into portable bundles, then render polished, chaptered videos from them",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "screen-studio": "./dist/cli/index.js",
    "screen-studio-mcp": "./dist/mcp/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.97"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1",
    "ws": "^8.19.0"
  },
  "license": "MIT",
  "keywords": [
    "screen-recording",
    "agents",
    "ios-simulator",
    "chrome-devtools",
    "video-editing",
    "chapters",
    "mcp"
  ]
}

{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "apps/desktop/main/**/*",
    "apps/desktop/preload/**/*",
    "scripts/runtime/**/*",
    "shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./out/types-node",
    "declarationDir": "./out/types-node",
    // shared/ re-exports the agent protocol's types from @zvada/agent-server,
    // whose raw TypeScript source imports with .ts extensions. See tsconfig.web.json.
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    // ON. Turning these off was justified by "@zvada/agent-server's TypeScript
    // source is part of this program, so unused-symbol checks would report ITS
    // nits as ours" — that is not what happens: the package is clean and the
    // only thing the check reported was deus's own dead import. This project
    // covers shared/**, which is exactly where dead re-exports accumulate
    // (Law 7 — dead schema reads as capability), so it is where the check earns
    // its keep. tsconfig.web.json stays off: the renderer's own program.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["electron-vite/node"]
  }
}

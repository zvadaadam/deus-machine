            },
            {
              "type": "text",
              "id": "D809QU",
              "name": "title",
              "fill": "$text-primary",
              "content": "Nine screens become five. Four of them become one list.",
              "fontFamily": "$font-sans",
              "fontSize": "$text-3xl",

            {
              "type": "text",
              "id": "C0hpj3",
              "name": "C1",
              "fill": "$note-text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Anatomy: slug + title (identity) · live activity line, only while the agent works — the current tool call, mono, like Conductor's card · chips = PR #/state, CI, diff · footer = branch → target, last activity. Everything except the live-activity line is already in the sidebar WS payload; activity comes from the session's latest in-flight tool part (prefetchWorkspace already warms it on hover).",
              "lineHeight": 1.55,
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal"
            },

            {
              "type": "text",
              "id": "s98a9O",
              "name": "Squircle note",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": 1000,
              "content": "Every rounded corner in the app is corner-shape: superellipse(1.5) — Apple continuous curvature, not a circular arc — and because squircle corners read tighter, --corner-radius-scale multiplies every token by 1.25. Base 8px (rounded-md) therefore ships as a 10px squircle. Pencil can only draw circular corners, so every rounded rectangle in this file is a stand-in; the comparison below is the real shape.",
              "lineHeight": 1.6,
              "fontFamily": "$font-sans",
              "fontSize": "$text-xs",
              "fontWeight": "normal"
            },
